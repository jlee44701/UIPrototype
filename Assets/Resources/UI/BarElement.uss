/* BarElement.uss */

.bar__container {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    min-height: 18px;
}

.bar__value-group {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 0;
    min-height: 18px;

    position: relative;
    overflow: hidden;
    border-radius: 4px;
}

.bar__background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(255, 255, 255, 0.15);
}

.bar__progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;

    width: 0%;
    background-color: rgba(0, 255, 0, 0.65);
}

.bar__label {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 0;
    bottom: 0;

    -unity-text-align: middle-left;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.65);
}
