:root {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
}

.unity-label {
    font-size: 35px;
}

.bar-progress{
    height: 8%;
    width: 84%;

    
    
    
}
.bar-progress__container{
    height: 100%;
    width: 100%;
    border-color: var(--color-pink-highlight);
    margin: 0.25%;
    flex-direction: row;
    border-left-width: 2;
    border-right-width: 2;
    border-top-width: 2;
    border-bottom-width: 2;
    align-items: flex-start;
    border-radius: 10px;
    padding:  1.25%;

}
.bound-progress__label{
    align-self: center;
}
.bar-progress__fill{
    height: 100%;
}
.bound-progress__label{
    position: absolute;
}

.depth__container
{
    flex-grow: 1;
}
.pressure__container
{
    flex-grow: 2;
}


.bar__container{
    flex-grow: 1;
    height: 100px;
}
.pressure-bar__background,
.pressure-bar__progress,
.pressure-bar__value-group{

}

.pressure-bar__value-group{
    flex-grow: 1;
    flex-basis: 0;
}

.pressure-bar__label,
.pressure-bar__background,
.pressure-bar__progress{
    flex-grow: 1;
}
.pressure-bar__background {
    background-color: white;
    position: absolute;
    width: 100%;
    height: 100%;
}
.pressure-bar__label{
    position: relative;
    height: 20%;
    width: 30%;
}


.pressure-bar__progress {
    position: relative;
    background-color: blue;
    min-width: 0;
    max-width: 100%;
}

.bar-element