.vibration__label{
    align-self: center;
    color: var(--color-white);
    text-shadow: var(--bar-progress-text-shadow-default);
     
}

.vibration__label{
    position: absolute;
}

.depth__container
{
    flex-grow: 1;
}
.pressure__container
{
    flex-grow: 2;
}


.bar__container{
    flex-grow: 1;
    height: 100px;
}




