@import url("../General_USS/Tokens.uss");

:root {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;

    --container__padding: 2%;
    --progress-fill__border-radius:  5px;
    --root__height: 9%;

}

.unity-label {
    font-size: 35px;
}

